<ot-sim>
  <message-bus>
    <pull-endpoint>tcp://127.0.0.1:4321</pull-endpoint>
    <pub-endpoint>tcp://127.0.0.1:5678</pub-endpoint>
  </message-bus>
  <cpu>
    <api-endpoint>0.0.0.0:9101</api-endpoint>
    <module name="backplane">ot-sim-message-bus {{config_file}}</module>
    <module name="modbus">ot-sim-modbus-module {{config_file}}</module>
    <module name="halucinator">ot-sim-halucinator-module {{config_file}}</module>
    <module name="logic">ot-sim-logic-module {{config_file}}</module>
  </cpu>
  <modbus name="modbus-outstation" mode="server">
    <endpoint>0.0.0.0:10502</endpoint>
    <!-- <register type="coil"> -->
    <!--   <address>30001</address> -->
    <!--   <tag>input1</tag> -->
    <!-- </register> -->
    <!-- <register type="coil"> -->
    <!--   <address>30002</address> -->
    <!--   <tag>output1</tag> -->
    <!-- </register> -->
  </modbus>
  <halucinator>
    <tag>_unused</tag>
  </halucinator>
  <logic name="test1">
    <period>1s</period>
    <process-updates>true</process-updates>
    <program><![CDATA[
      tick = (tick > 15) ? 0 : (tick + 1)
      motor_set = tick > 0 && tick < 5
      motor_reset = tick > 10 && tick < 15
      output = motor_status
    ]]></program>
    <variables>
      <motor_set tag="gpio_pin_90">0</motor_set>
      <motor_reset tag="gpio_pin_93">0</motor_reset>
      <motor_status tag="gpio_pin_36">0</motor_status>
    </variables>
  </logic>
</ot-sim>
